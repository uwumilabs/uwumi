<resources>
  <style name="UwumiCastDialog_default_light" parent="Theme.MediaRouter.Light">
    <item name="android:windowBackground">@drawable/cast_dialog_background</item>
    <item name="android:colorBackground">#FCF7FF</item>
    <item name="android:textColorPrimary">#1B1B1F</item>
