    <item name="colorPrimaryDark">#0058CA</item>
    <item name="android:borderlessButtonStyle">@style/UwumiCastDialogButton_default_light</item>
  </style>
  <!-- The app's Material 3 theme makes the dialog's buttons MaterialButtons, which ignore colorPrimary above -->
  <style name="UwumiCastDialogButton_default_light" parent="Widget.Material3.Button.TextButton">
    <item name="android:textColor">#0058CA</item>
  </style>
  <style name="UwumiCastDialogOverlay_default_light">
    <item name="mediaRouteTheme">@style/UwumiCastDialog_default_light</item>
  </style>

