{
  "expo": {
    "name": "uwumi",
    "slug": "uwumi",
    "version": "4.0.0-rc.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uwumi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "buildNumber": "43",
      "bundleIdentifier": "com.x2004durgesh.uwumi",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.x2004durgesh.uwumi",
      "versionCode": 43,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "uwumi.vercel.app",
              "pathPrefix": "/info"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidDebugVariant",
      "./plugins/withRnCoreFlavorMarker",
      "./plugins/withPictureInPicture",
      "./plugins/withBackgroundDownloads",
      "./plugins/withAndroidTV",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# Room (WorkManager, pulled in by nitro-ota) creates its generated database by reflection at launch\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n# Nitro creates its Kotlin hybrid objects from C++ over JNI, which R8 can't see\n-keep class com.margelo.nitro.** { *; }\n# ffmpeg-kit's native code finds FFmpegKitConfig/AbiDetect and their callbacks by name\n-keep class com.arthenica.ffmpegkit.** { *; }"
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4",
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Material3",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "expo-web-browser",
      "expo-navigation-bar",
      "react-native-orientation-director",
      "expo-image",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": false,
          "showVerboseWarnings": false,
          "tvosDeploymentTarget": "15.1",
          "removeFlipperOnAndroid": true,
          "androidTVBanner": "./assets/images/tv/tv_banner.png",
          "androidTVIcon": "./assets/images/tv/tv_icon.png",
          "appleTVImages": {
            "icon": "./assets/images/tv/myimage-tvos-1280x768.png",
            "iconSmall": "./assets/images/tv/myimage-tvos-400x240.png",
            "iconSmall2x": "./assets/images/tv/myimage-tvos-800x480.png",
            "topShelf": "./assets/images/tv/myimage-tvos-1920x720.png",
            "topShelf2x": "./assets/images/tv/myimage-tvos-3840x1440.png",
            "topShelfWide": "./assets/images/tv/myimage-tvos-2320x720.png",
            "topShelfWide2x": "./assets/images/tv/myimage-tvos-4640x1440.png"
          }
        }
      ],
      "react-native-nitro-ota",
      "expo-document-picker",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "src/modules"
        ]
      }
    }
  }
}