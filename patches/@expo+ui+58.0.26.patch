+/**
+ * Returns the system bars (status, navigation) the activity window has hidden right now, for
+ * example because a video player is in immersive fullscreen. Read it before the sheet opens: once
+ * the sheet's dialog window takes over the system bars, the activity reports them as visible.
+ */
+@Composable
+private fun rememberActivityHiddenSystemBars(): Int {
+  val hostView = LocalView.current
+  return remember {
+    val insets = ViewCompat.getRootWindowInsets(hostView) ?: return@remember 0
+    var hidden = 0
+    if (!insets.isVisible(WindowInsetsCompat.Type.statusBars())) {
+      hidden = hidden or WindowInsetsCompat.Type.statusBars()
+    }
+    if (!insets.isVisible(WindowInsetsCompat.Type.navigationBars())) {
+      hidden = hidden or WindowInsetsCompat.Type.navigationBars()
+    }
+    hidden
+  }
+}
+
+/**
+ * The sheet's dialog window doesn't inherit the activity's immersive mode, so Android shows the
+ * system bars again while the sheet is open. Hide the bars the activity had hidden on the sheet's
+ * window too.
+ */
+@Composable
+private fun HideSystemBarsInSheetWindow(hiddenSystemBars: Int) {
+  if (hiddenSystemBars == 0) {
+    return
+  }
+  val view = LocalView.current
+  val window = (view.parent as? DialogWindowProvider)?.window ?: return
+
+  DisposableEffect(window, hiddenSystemBars) {
+    WindowCompat.getInsetsController(window, view).apply {
+      systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+      hide(hiddenSystemBars)
+    }
+    onDispose {}
+  }
+}
