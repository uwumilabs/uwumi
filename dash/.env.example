# Copy to .env.local and fill in. On Vercel, add the same keys under Project Settings → Environment Variables.
# Both keys are on the Clerk dashboard → API keys.

# Required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: send Clerk's sign-in and sign-up redirects to the dash's own /sign-in and /sign-up pages
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
