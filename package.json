{
  "name": "uwumi",
  "main": "expo-router/entry",
  "version": "3.1.0",
  "scripts": {
    "start": "expo start --localhost",
    "android:reverse": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:3001 tcp:3001 && expo run:android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "generate-themes": "tamagui generate-themes ./src/constants/Theme.ts ./src/constants/theme-out.ts",
    "prepare": "husky install",
    "release": "release-it",
    "sync-versions": "node ./src/scripts/sync-versions.js",
    "build-android": "bash src/scripts/build-android.sh",
    "postinstall": "cd android && ./gradlew :app:downloadAar"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,html,css}": [
      "eslint --fix .",
      "prettier --write ."
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "hooks": {
      "after:bump": [
        "npm run sync-versions",
        "npm run build-android"
      ],
      "after:release": "echo Successfully released v${version}"
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^0.7.8",
    "@dr.pogodin/react-native-fs": "^2.36.0",
    "@expo-google-fonts/inter": "^0.2.3",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "@tamagui/animations-react-native": "^1.134.2",
    "@tamagui/babel-plugin": "^1.134.2",
    "@tamagui/cli": "^1.134.2",
    "@tamagui/config": "^1.134.2",
    "@tamagui/lucide-icons": "^1.134.2",
    "@tamagui/portal": "^1.134.2",
    "@tamagui/theme-builder": "^1.134.2",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "expo": "54.0.12",
    "expo-blur": "~15.0.7",
    "expo-brightness": "~14.0.7",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.13",
    "expo-font": "~14.0.8",
