{
  "name": "uwumi",
  "main": "expo-router/entry",
  "version": "4.0.0-rc.3",
  "scripts": {
    "start": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start",
    "android:reverse": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:3001 tcp:3001 && expo run:android",
    "android": "expo run:android",
    "android:device": "cd android && ./gradlew :app:assembleDebug -PdebugSuffix && cd ..",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "prepare": "husky install",
    "postinstall": "patch-package",
    "release": "release-it",
    "sync-versions": "node ./src/scripts/sync-versions.js",
    "build-android": "bash src/scripts/build-android.sh",
    "build-ios": "bash src/scripts/build-ios.sh",
    "ota": "bash src/scripts/publish-ota.sh",
    "dash": "yarn --cwd dash dev",
    "dash:install": "yarn --cwd dash install",
    "dash:build": "yarn --cwd dash build",
    "perf": "EXPO_PUBLIC_PERF_RUN=screens REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --clear",
    "perf:watch": "EXPO_PUBLIC_PERF_RUN=watch REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --clear"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,html,css}": [
      "eslint --fix .",
      "prettier --write ."
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": true,
      "requireUpstream": true
    },
    "hooks": {
      "after:bump": [
        "npm run sync-versions",
        "npm run build-android",
        "npm run build-ios"
      ],
      "after:release": "echo Successfully released v${version}"
    },
    "github": {
      "release": true,
      "assets": [
        "android/app/build/outputs/apk/release/uwumi-*-v${version}.apk",
        "ios/build/uwumi-v${version}.ipa"
      ]
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/dash/"
    ]
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.36.0",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.66.0",
    "expo": "^58.0.19",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "heroui-native": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88-stable",
    "react-native-background-actions": "^4.0.1",
    "react-native-consumet": "^2.0.0",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-ffmpeg-kit": "7.0.0-beta.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-material-ripple": "^0.9.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-ota": "0.14.1",
    "react-native-orientation-director": "^2.6.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-video": "github:pigeonmal/react-native-video#ajami1.4.1",
    "react-native-video-toolkit": "^0.13.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.17",
    "uniwind": "1.13.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@react-native-community/cli": "latest",
    "@react-native-tvos/config-tv": "^0.1.5",
    "@react-native/metro-config": "^0.81.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tanstack/eslint-plugin-query": "^5.60.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.14",
    "@types/react": "~19.3.0",
    "@types/react-native-material-ripple": "^0.9.6",
    "@types/react-test-renderer": "^19.1.0",
    "auto-changelog": "^2.5.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^11.0.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "^15.4.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "release-it": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "RUNTIME_TEST_FLAG": true,
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "EXPERIMENTAL_CSS_ANIMATIONS_FOR_SVG_COMPONENTS": true,
      "USE_SYNCHRONIZABLE_FOR_MUTABLES": true,
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true,
      "ENABLE_SHARED_ELEMENT_TRANSITIONS": true,
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": true
    }
  },
  "worklets": {
    "staticFeatureFlags": {
      "RUNTIME_TEST_FLAG": true,
      "IOS_DYNAMIC_FRAMERATE_ENABLED": true
    }
  }
}
